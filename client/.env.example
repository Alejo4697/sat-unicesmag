# ==========================================================================
#  SAT-UNICESMAG - Variables de entorno del cliente (Vite)
#  Copia este archivo a client/.env y ajusta el valor si es necesario.
#  Las variables de Vite deben empezar con VITE_ para quedar expuestas al
#  navegador (ver https://vitejs.dev/guide/env-and-mode.html).
# ==========================================================================

# URL base de la API del backend (client/src/shared/api/client.js).
# Opcional - si no se define, el cliente usa http://localhost:4000/api.
VITE_API_URL=http://localhost:4000/api
