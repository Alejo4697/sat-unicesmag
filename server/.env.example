# ==========================================================================
#  SAT-UNICESMAG - Variables de entorno del servidor (Express)
#  Copia este archivo a server/.env y completa los valores reales.
#  Ninguno de los valores de abajo es real - son solo placeholders.
# ==========================================================================

# --- Servidor HTTP --------------------------------------------------------
# Puerto donde arranca Express (server/src/server.js). Obligatoria.
PORT=5000
# Origen permitido por CORS - la URL del frontend (server/src/app.js). Obligatoria.
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL principal (schema `sat`) ----------------------------------
# Usada por server/src/shared/db/pool.js. Obligatorias: sin estas, cualquier
# feature que ya consulte Postgres real (la mayoría) falla al arrancar.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Envío de correo (OTP de estudiantes - server/src/shared/services/emailService.js)
# Opcional: si ninguna de las dos vías de abajo está completa, el código OTP
# solo se imprime en la consola del servidor (sirve para desarrollo local).
#
# Vía 1 - SMTP genérico (tiene prioridad si HOST + USER/EMAIL_USER + PASS/EMAIL_PASS están completos):
# UNICESMAG utiliza Google Workspace (smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adviser@unicesmag.edu.co
SMTP_PASS=
SMTP_FROM="SAT UNICESMAG <adviser@unicesmag.edu.co>"
# Alias aceptados en vez de SMTP_USER / SMTP_PASS:
EMAIL_USER=
EMAIL_PASS=
#
# Vía 2 - Gmail (se usa solo si no se configuró SMTP_HOST):
GMAIL_USER=adviser@unicesmag.edu.co
GMAIL_PASS=

# --- Sincronización con la BD académica institucional ---------------------
# Usada por syncService.js / autoSyncScheduler.js para traer estudiantes,
# matrículas, etc. desde la base de datos académica real de la universidad.
# HOST, USER y PASSWORD son OBLIGATORIAS: el código ya no tiene ningún valor
# de respaldo (antes sí lo tenía, era un riesgo de seguridad ya corregido) -
# si faltan, ejecutarSincronizacion() lanza un error en vez de conectar.
ACADEMIC_DB_HOST=
ACADEMIC_DB_PORT=5432
ACADEMIC_DB_NAME=
ACADEMIC_DB_USER=
ACADEMIC_DB_PASSWORD=
